erminal\" | \"retry_exhausted\" | \"budget_exhausted\";\n5:export type Admission = { allowed: true; ticket: string } | { allowed: false; reason: DenialReason };\n6:export interface Snapshot {\n7:  turnId: string | null;\n8:  revision: number;\n9:  admissions: number;\n10:  pending: number;\n11:  closed: boolean;\n12:}\n13:export class ToolLoopGuard {\n14:  constructor() {}\n15:  beginTurn(_turnId: string): void { throw new Error(\"Not implemented\"); }\n16:  markWorkspaceChanged(_revision: number): void { throw new Error(\"Not implemented\"); }\n17:  admit(_tool: string, _args: unknown): Admission { throw new Error(\"Not implemented\"); }\n18:  complete(_ticket: string, _outcome: Outcome): void { throw new Error(\"Not implemented\"); }\n19:  snapshot(): Snapshot { throw new Error(\"Not implemented\"); }\n20:}</tool_response>\n<tool_response>[tests/public-smoke.test.cjs#50F6]\n1:const test = require('node:test');\n2:const assert = require('node:assert/strict');\n3:const { ToolLoopGuard } = require('../dist/tool-loop-guard.js');\n4:\n5:test('an unchanged empty search is not repeated', () => {\n6:  const guard = new ToolLoopGuard();\n7:  guard.beginTurn('smoke');\n8:  const call = guard.admit('rg', { pattern: 'missing', path: 'src' });\n9:  assert.equal(call.allowed, true);\n10:  guard.complete(call.ticket, 'no_matches');\n11:  assert.deepEqual(guard.admit('rg', { path: 'src', pattern: 'missing' }), {\n12:    allowed: false,\n13:    reason: 'repeat_terminal',\n14:  });\n15:});</tool_response>\n<tool_response>[package.json#7B6B]\n1:{\n2:  \"name\": \"rg-01-benchmark\",\n3:  \"version\": \"1.0.0\",\n4:  \"private\": true,\n5:  \"type\": \"commonjs\",\n6:  \"scripts\": {\n7:    \"check\": \"tsc --noEmit -p tsconfig.json\",\n8:    \"build\": \"tsc -p tsconfig.json\",\n9:    \"test\": \"npm run build && node --test\"\n10:  },\n11:  \"devDependencies\": {\n12:    \"typescript\": \"5.9.3\"\n13:  }\n14:}</tool_response>\n<tool_response>[tsconfig.json#B07F]\n1:{\n2:  \"compiler